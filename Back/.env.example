# Nunca versione o arquivo .env com valores reais.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/voxify
AUTO_CREATE_SCHEMA=false
JWT_SECRET_KEY=gere-uma-chave-aleatoria-com-ao-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Configure o bucket R2 como privado; não exponha as chaves no frontend.
